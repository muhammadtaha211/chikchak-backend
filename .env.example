# ChikChak backend — required environment variables.
# Copy this to a real .env (or set these in your cloud dashboard) and fill in values.
# Anything without a default in application.properties MUST be set or the app will fail to start.

# --- Database (REQUIRED) ---
DB_URL=jdbc:postgresql://your-db-host:5432/CC
DB_USERNAME=postgres
DB_PASSWORD=replace-with-real-db-password

# --- JWT (REQUIRED) ---
# Generate a strong random secret (e.g. `openssl rand -base64 64`). Do NOT reuse the dev value.
JWT_SECRET=replace-with-a-long-random-secret
# Token lifetime in milliseconds. Default 2592000000 = 30 days.
JWT_EXPIRATION=2592000000

# --- CORS / WebSocket allowed origins (REQUIRED in prod) ---
# Comma-separated list of allowed frontend origins. No trailing slash.
ALLOWED_ORIGINS=https://app.chikchak.com,https://admin.chikchak.com

# --- Email (optional; leave blank to disable mail sending) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Spring profile ---
# Set to "local" to load application-local.properties during development.
# Leave unset (or set to a non-"local" value) in production.
SPRING_PROFILES_ACTIVE=local
