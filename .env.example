# ChikChak backend — required environment variables.
# Copy this to a real .env (or set these in your cloud dashboard) and fill in values.
# Anything without a default in application.properties MUST be set or the app will fail to start.

# --- Database (REQUIRED) ---
DB_URL=jdbc:postgresql://your-db-host:5432/CC
DB_USERNAME=postgres
DB_PASSWORD=replace-with-real-db-password

# --- JWT (REQUIRED) ---
# Generate a strong random secret (e.g. `openssl rand -base64 64`). Do NOT reuse the dev value.
JWT_SECRET=replace-with-a-long-random-secret
# Token lifetime in milliseconds. Default 604800000 = 7 days.
JWT_EXPIRATION=604800000

# --- Initial admin user (REQUIRED to seed an admin; leave blank to skip seeding) ---
# The first admin account is created from these on startup if it doesn't already exist.
# Use a strong password; it is BCrypt-hashed and never stored in plaintext.
ADMIN_EMAIL=admin@chikchak.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# --- CORS / WebSocket allowed origins (REQUIRED in prod) ---
# Comma-separated list of allowed frontend origins. No trailing slash.
ALLOWED_ORIGINS=https://app.chikchak.com,https://admin.chikchak.com

# --- Email (optional; leave blank to disable mail sending) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Firebase (optional; leave unset to disable push notifications) ---
# Paste the full service-account JSON as a single-line value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Rate limiting & request size (optional; sensible defaults in application.properties) ---
# RATELIMIT_AUTH_CAPACITY=5
# RATELIMIT_AUTH_WINDOW_MINUTES=15
# RATELIMIT_WRITE_CAPACITY=60
# RATELIMIT_WRITE_WINDOW_MINUTES=1
# REQUEST_MAX_JSON_BYTES=1048576

# --- Spring profile ---
# Set to "local" to load application-local.properties during development.
# Leave unset (or set to a non-"local" value) in production.
SPRING_PROFILES_ACTIVE=local
